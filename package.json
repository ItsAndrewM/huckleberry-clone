{
  "name": "baby-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bt/web dev",
    "build": "pnpm --filter @bt/web build",
    "lint": "oxlint --disable-nested-config . && oxfmt --disable-nested-config --check .",
    "format": "oxfmt --disable-nested-config .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "coverage": "vitest run --project domain --coverage",
    "bundle:check": "node scripts/check-bundle-size.ts",
    "e2e": "playwright test",
    "pins:check": "node scripts/check-pins.ts",
    "api:docs": "node scripts/api-docs.ts"
  },
  "devDependencies": {
    "@gamesheet-inc/oxlint-plugin": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@10.32.1"
}
