{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["date-fns", "date-fns/**", "@date-fns/**"],
                "message": "Dates and time zones go through @bt/domain only (D12)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["@bt/**"], "message": "@bt/domain imports nothing else from the workspace (plan §1)." },
                  {
                    "group": [
                      "effect",
                      "effect/**",
                      "@effect/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "cloudflare:*",
                      "node:*"
                    ],
                    "message": "@bt/domain is pure TypeScript: no framework or runtime imports (plan §3.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["date-fns", "date-fns/**", "@date-fns/**"],
                    "message": "Dates and time zones go through @bt/domain only (D12)."
                  },
                  {
                    "group": ["@bt/web", "@bt/worker"],
                    "message": "@bt/contracts may import @bt/domain only (plan §1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["date-fns", "date-fns/**", "@date-fns/**"],
                    "message": "Dates and time zones go through @bt/domain only (D12)."
                  },
                  { "group": ["@bt/worker", "@bt/worker/**"], "message": "The client never imports Worker code." }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/worker/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["date-fns", "date-fns/**", "@date-fns/**"],
                    "message": "Dates and time zones go through @bt/domain only (D12)."
                  },
                  { "group": ["@bt/web", "@bt/web/**"], "message": "The Worker never imports client code." }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
