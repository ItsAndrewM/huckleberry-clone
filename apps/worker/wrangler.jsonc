{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baby-tracker",
  // Pinned so a deploy can never land in another account wrangler is logged into.
  "account_id": "6624f09210327baade61004af0d9be84",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  // The workers.dev hostname is the only entry point, and the one the Access app covers (M1.16).
  "preview_urls": false,
  "assets": {
    // No `directory`: @cloudflare/vite-plugin points it at apps/web's client build.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
