{
  "openapi": "3.1.0",
  "info": {
    "title": "Baby tracker",
    "version": "0.0.1"
  },
  "paths": {
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "me.me",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "caregiver": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "displayName"
                      ],
                      "additionalProperties": false
                    },
                    "household": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "timeZone": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "timeZone"
                      ],
                      "additionalProperties": false
                    },
                    "child": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "birthDate": {
                          "type": "string",
                          "format": "date"
                        }
                      },
                      "required": [
                        "name",
                        "birthDate"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "caregiver",
                    "household",
                    "child"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "InvalidInput",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidInputEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "InvalidInputEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidInput"
            ]
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "issue": {
                  "type": "string",
                  "enum": [
                    "not_finite",
                    "not_positive",
                    "too_many_decimals",
                    "end_not_after_start",
                    "before_birth",
                    "in_future",
                    "out_of_range",
                    "invalid"
                  ]
                }
              },
              "required": [
                "path",
                "issue"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "_tag",
          "fieldErrors"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "me"
    }
  ]
